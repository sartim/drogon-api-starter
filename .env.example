SECRET_KEY=replace-with-a-long-random-secret
DB_HOST=127.0.0.1
DB_PORT=5432
DB_CONNECTION_POOL_SIZE=4
DB_QUERY_TIMEOUT_SECONDS=10
DB_NAME=drogon_user_service
DB_USER=postgres
DB_PASSWORD=replace-with-your-local-password
# Optional. Leave empty to run without Sentry.
SENTRY_DSN=
ERROR_TRACKING_PROVIDER=none
HTTP_HOST=0.0.0.0
HTTP_PORT=8000
HTTP_IDLE_CONNECTION_TIMEOUT_SECONDS=60
RATE_LIMIT_REQUESTS=0
RATE_LIMIT_WINDOW_SECONDS=60
REDIS_ENABLED=false
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_CONNECTION_POOL_SIZE=2
REDIS_COMMAND_TIMEOUT_SECONDS=1
REDIS_PASSWORD=
REDIS_DB=0
