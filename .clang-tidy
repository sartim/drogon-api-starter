Checks: >-
  -*,
  bugprone-*,-bugprone-easily-swappable-parameters,
  cert-*,-cert-err58-cpp,
  cppcoreguidelines-*,-cppcoreguidelines-avoid-magic-numbers,
  performance-*,-performance-avoid-endl,
  portability-*,
  readability-*,-readability-identifier-length,-readability-magic-numbers
WarningsAsErrors: ''
HeaderFilterRegex: '(^|/)(controllers|filters|helpers|models|schemas|tables)/.*\\.(h|cc)$'
